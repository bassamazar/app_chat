# ⚙️ Server Configuration
PORT=5000
NODE_ENV=development

# 🗄️ Database Connection URL (Prisma)
# استبدل اليوزر والباسوورد واسم الداتا بيس بمعلوماتك الحقيقية في ملف .env
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/chat_db_name?schema=public"

# 🔐 Authentication
# حط أي نص عشوائي قوي ككلمة سر للتشفير
JWT_SECRET="your_super_secret_jwt_key_here_12345"
JWT_EXPIRES_IN="7d"

# 🌐 Frontend URL (For CORS and Socket.io)
CLIENT_URL="http://localhost:5173"